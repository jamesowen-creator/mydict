ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
APP_PASSWORD=your_password
ADMIN_EMAILS=admin@example.com,other@example.com

# PostgreSQL (required for wordbook/review/Google 로그인 사용자 저장/MetaCong 캐시)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Google OAuth (둘 다 설정해야 활성화됨 — 하나라도 비어있으면 /auth/google이 503 반환)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# 로컬: http://localhost:3000/auth/google/callback
# 배포(Railway): https://<your-domain>/auth/google/callback
# 값을 반드시 Google Cloud Console의 "승인된 리디렉션 URI"와 정확히 일치시킬 것
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# 세션/토큰 서명 키 (운영 환경에서는 반드시 별도 값으로 설정 — 기본값 사용 시 JWT 위조 위험)
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_a_long_random_string
